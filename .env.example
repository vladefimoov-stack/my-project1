# ─────────────────────────────────────────────────────────────
# Keyline store — environment variables
# Copy to .env.local (development) or set in your hosting dashboard.
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical / hreflang / sitemap)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Email delivery: "resend" (production) or "log" (local development only —
# prints the email to the server console and is REFUSED when NODE_ENV=production)
EMAIL_PROVIDER=resend

# Resend API key (https://resend.com) — server-side only
RESEND_API_KEY=

# Verified sender, e.g. "Keyline Orders <orders@your-domain.com>"
EMAIL_FROM=

# Who receives test-order notifications
ORDER_NOTIFICATION_EMAIL=vladefimoov@gmail.com

# Optional: send the customer a confirmation email too ("true"/"false")
SEND_CUSTOMER_CONFIRMATION=false

# Rate limit: max order submissions per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# Optional server-side IP geolocation fallback, used only when the hosting
# platform does not provide a country header (Vercel/Cloudflare/CloudFront do).
# The visitor IP is appended to the URL. The service must return JSON with
# a "country_code" or "countryCode" or "country" field (ISO-3166 alpha-2).
# Example: https://ipapi.co/{ip}/json/
GEOIP_API_URL=

# Allow the internal /render route used to regenerate product renders
# (always available in development, disabled in production unless "true")
ENABLE_RENDER_ROUTE=false
